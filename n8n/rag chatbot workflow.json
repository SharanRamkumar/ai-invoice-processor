        "jsCode": "const question = $input.first().json.body.question;\n\nif (!question || !question.trim()) {\n    throw new Error(\"Question is required\");\n}\n\nreturn [\n    {\n        json: {\n            question: question.trim()\n        }\n    }\n];"
